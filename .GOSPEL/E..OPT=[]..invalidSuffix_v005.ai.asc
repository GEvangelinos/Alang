// __CMP_RUN__: %DRIVER %ERROR_MODE --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __DESC__: Comprehensive test suite for invalid floating-point literal suffixes across fractional dots, exponents, leading/trailing zeros, and operator collisions.
// __AI_GENERATED__

// __BEGIN_SOURCE__
// 1. Fractional constants with single-character suffixes (lower/upper)
f0 = 3.14f;                 // Base: 3.14, Suffix: "f" (C-style float suffix)
f1 = 0.5d;                  // Base: 0.5, Suffix: "d" (double suffix)
f2 = 123.456K;              // Base: 123.456, Suffix: "K" (uppercase single char)
f3 = 0.0z;                  // Base: 0.0, Suffix: "z" (zero float with char)

// 2. Fractional constants with multi-character/identifier suffixes
f4 = 1.0invalid;            // Base: 1.0, Suffix: "invalid"
f5 = 2.71828suffix;         // Base: 2.71828, Suffix: "suffix"
f6 = 0.123_bad_float;       // Base: 0.123, Suffix: "_bad_float"
f7 = 99.99_tail_;           // Base: 99.99, Suffix: "_tail_"

// 3. Leading-dot / Trailing-dot floats with invalid suffixes
f8 = .5f;                   // Base: .5 (0.5), Suffix: "f"
f9 = .123invalid;           // Base: .123, Suffix: "invalid"
f10 = 42.f;                 // Base: 42., Suffix: "f"
f11 = 100.custom;           // Base: 100., Suffix: "custom"

// 4. Valid scientific notation (integer & float bases) with invalid suffixes
f12 = 1e10f;                // Base: 1e10, Suffix: "f"
f13 = 2.5E+3d;              // Base: 2.5E+3, Suffix: "d"
f14 = 5e-2bad;              // Base: 5e-2, Suffix: "bad"
f15 = .75e4_xyz;            // Base: .75e4, Suffix: "_xyz"
f16 = 1.0e+00zero;          // Base: 1.0e+00, Suffix: "zero"

// 5. Zero-base and edge-case exponents with suffixes
f17 = 0.0e0invalid;         // Base: 0.0e0, Suffix: "invalid"
f18 = 0e5suffix;            // Base: 0e5, Suffix: "suffix"
f19 = 10.E-1q;              // Base: 10.E-1, Suffix: "q"

// 6. Operator and delimiter boundary collisions without whitespace
f20 = 1.5f+2.5d;            // Term 1: 1.5 "f"; Term 2: 2.5 "d" (stops at '+')
f21 = (3.14invalid)*2.0;    // Base: 3.14, Suffix: "invalid" (stops at ')')
f22 = [0.1bad, .2bad];      // Element 1: 0.1 "bad" (stops at ','); Element 2: .2 "bad" (stops at ']')
f23 = 1e+2suffix/2.0;       // Base: 1e+2, Suffix: "suffix" (stops at '/')
// __END_SOURCE__

