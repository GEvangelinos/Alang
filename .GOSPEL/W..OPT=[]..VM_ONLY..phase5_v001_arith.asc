// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
    Test file for the final phase of HY-340: Languages & Compilers
    Computer science dpt, University of Crete, Greece

    Expected Output:
	3.000 6.000 9.000 54.000
	18.000 9.000
	54.000 54.000 54.000 54.000
	0.000 0.000
	-9.000
	20.000
	16.500
	0.000
	3.000 6.000 6.000 9.000 0.000
*/

nl = "\n";
sp = " ";

a = 3;
b=6;
c = 9;
d  =  54;

print(a, sp, b, sp, c, sp, d, nl);

a = 4;
a = a+5;
b = a;
a = a+b;

print(a, sp, b, nl);

a = b = c = d;

print(a, sp, b, sp, c, sp, d, nl);

a = b = -(-(c+d)*(a-b))%-b;

print(a, sp, b, nl);

a = 4;
b = 5;
c = 7;
d = 8;

e = a+b+c+d;
e = a+(b+(c+d));
e = -a+b;
e = -(a+b);

print(e, nl);

e = a*b-c/d%e;

print(e, nl);

e = a*(b-c/((0.0+d)%e));

print(e, nl);

e = -(-(a+b)/-(c+d))%e;

print(e, nl);

a---++b+--c-d++;

print(a, sp, b, sp, c, sp, d, sp, e, nl);
// __END_SOURCE__

// __BEGIN_VM_OUT__
// 	3 6 9 54
// 	18 9
// 	54 54 54 54
// 	0 0
// 	-9
// 	20
// 	16.5
// 	0
// 	3 6 6 9 0
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
