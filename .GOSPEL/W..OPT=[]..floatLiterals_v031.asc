// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / arithmetic & literal suffix coverage
 * Targets: Mixed integer and float literals with various delimiter transitions
 *
 *     250.0            (1000 / 4.0f)       (paren boundary)
 *   +  37.5            (75.0F/2)           (slash operator boundary)
 *   +   0.125          (1.0f / 8.0f)       (f-to-f binary op)
 *   + 120.0            (1.2e2f)            (scientific lower e + f)
 *   +  -5.0            (-0.5e+1F)          (unary minus + explicit sign + F)
 *   +   0.003          (30.0e-4f)          (negative scientific exp)
 *   + 100.0            (8.0f*12.5f)        (direct multiplication)
 *   = 502.628
 *
 * Expected output:
 *   float math total = 502.628
 */

total =   (1000 / 4.0f)
        + (75.0F/2)
        + (1.0f / 8.0f)
        + (1.2e2f)
        + (-0.5e+1F)
        + (30.0e-4f)
        + (8.0f*12.5f);

print("float math total = ", total, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// float math total = 502.628
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__