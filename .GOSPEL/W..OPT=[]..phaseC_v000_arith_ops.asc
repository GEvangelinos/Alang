// __CMP_RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
x + y;
z * w;
t - s;
u / v;
r % l;

// Will not yield any quads if constant operations
// are calculated during compilation.
4 + 5;
6 * 8;
4 - 9;
3 / 1;
0 % 3;

// This should be an error but not mandatory
4 / 0;
x / 0;
// __END_SOURCE__

