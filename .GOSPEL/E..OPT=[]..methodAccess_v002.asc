// __BEGIN_SOURCE__
15..20; // These are 2 floating point constants with opposing formats. first is '15.' second is '.20'
(15)..20; // (15).. satifies the expr METHOD_CALL part but not the ID part.. that is why it asks about IDENTIFIER. GARBAGE DIAGNOSTIC TO GARBAGE INPUT
(15)..(20); // (15).. satifies the expr METHOD_CALL part but not the ID part.. that is why it asks about IDENTIFIER. GARBAGE DIAGNOSTIC TO GARBAGE INPUT

15..method();
(15)..method();
(15 / 2 + num - 3)..method();
(15 / 2)..method();
// __END_SOURCE__

