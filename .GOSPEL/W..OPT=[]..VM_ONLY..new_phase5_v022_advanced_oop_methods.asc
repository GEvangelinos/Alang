// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * ADVANCED / objects with methods (the '..' method-call operator)
 * Implements a Stack (LIFO) and a Queue (FIFO) as objects whose methods are
 * stored as members and invoked with 'obj..method(args)', which passes 'obj'
 * as the implicit first parameter ('self').
 *
 * Expected output:
 *   stack push 1 2 3, size 3
 *   stack peek -> 3
 *   stack pop  -> 3 2 1
 *   stack empty -> true
 *   queue enqueue a=10 b=20 c=30
 *   queue dequeue -> 10 20 30
 *   queue empty -> true
 */

function newStack() {
	return [
		{ "data" : [] },
		{ "size" : 0  },
		{ "push" : (function(self, x) {
			self.data[self.size] = x;
			self.size = self.size + 1;
		}) },
		{ "pop" : (function(self) {
			self.size = self.size - 1;     // assume non-empty caller
			return self.data[self.size];
		}) },
		{ "peek" : (function(self) {
			return self.data[self.size - 1];
		}) },
		{ "isEmpty" : (function(self) {
			return self.size == 0;
		}) }
	];
}

s = newStack();
s..push(1);
s..push(2);
s..push(3);
print("stack push 1 2 3, size ", s.size, "\n");

pk = s..peek();
print("stack peek -> ", pk, "\n");

p1 = s..pop();
p2 = s..pop();
p3 = s..pop();
print("stack pop  -> ", p1, " ", p2, " ", p3, "\n");

emptyS = s..isEmpty();
print("stack empty -> ", emptyS, "\n");

function newQueue() {
	return [
		{ "data" : [] },
		{ "head" : 0  },
		{ "tail" : 0  },
		{ "enqueue" : (function(self, x) {
			self.data[self.tail] = x;
			self.tail = self.tail + 1;
		}) },
		{ "dequeue" : (function(self) {
			v = self.data[self.head];
			self.head = self.head + 1;
			return v;
		}) },
		{ "isEmpty" : (function(self) {
			return self.head == self.tail;
		}) }
	];
}

q = newQueue();
q..enqueue(10);
q..enqueue(20);
q..enqueue(30);
print("queue enqueue a=10 b=20 c=30\n");

d1 = q..dequeue();
d2 = q..dequeue();
d3 = q..dequeue();
print("queue dequeue -> ", d1, " ", d2, " ", d3, "\n");

emptyQ = q..isEmpty();
print("queue empty -> ", emptyQ, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// stack push 1 2 3, size 3
// stack peek -> 3
// stack pop  -> 3 2 1
// stack empty -> true
// queue enqueue a=10 b=20 c=30
// queue dequeue -> 10 20 30
// queue empty -> true
// __END_VM_OUT__

