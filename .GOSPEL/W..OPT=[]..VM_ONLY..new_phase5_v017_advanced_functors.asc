// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * ADVANCED / BONUS -- functors (objects you can "call")
 * A table that has a "()" member can be called like a function; the table is
 * passed as the implicit first argument.
 *
 * Expected output:
 *   counter: 1 2 3
 *   accumulator total: 35
 *   adder(10)(7) = 17
 *   calc add 6+4 = 10
 *   calc mul 6*4 = 24
 *   calc sub 6-4 = 2
 */

// A stateful counter object: each call bumps and returns its count.
function makeCounter() {
	return [
		{ "n"  : 0 },
		{ "()" : (function(self) {
			self.n = self.n + 1;
			return self.n;
		}) }
	];
}

counter = makeCounter();
c1 = counter();
c2 = counter();
c3 = counter();
print("counter: ", c1, " ", c2, " ", c3, "\n");

// An accumulator: call it with a number to add it to a running total.
function makeAccumulator() {
	return [
		{ "total" : 0 },
		{ "()" : (function(self, x) {
			self.total = self.total + x;
			return self.total;
		}) }
	];
}

acc = makeAccumulator();
acc(5);
acc(10);
last = acc(20);
print("accumulator total: ", last, "\n");

// A functor that returns another functor (currying-ish).
function makeAdder() {
	return [
		{ "()" : (function(self, a) {
			return [
				{ "a"  : a },
				{ "()" : (function(inner, b) { return inner.a + b; }) }
			];
		}) }
	];
}

adder = makeAdder();
add10 = adder(10);
r = add10(7);
print("adder(10)(7) = ", r, "\n");

// A calculator dispatched on an operation name through its functor.
function makeCalc() {
	return [
		{ "()" : (function(self, op, x, y) {
			if (op == "add") return x + y;
			else if (op == "mul") return x * y;
			else if (op == "sub") return x - y;
			else return nil;
		}) }
	];
}

calc = makeCalc();
a = calc("add", 6, 4);
b = calc("mul", 6, 4);
c = calc("sub", 6, 4);
print("calc add 6+4 = ", a, "\n");
print("calc mul 6*4 = ", b, "\n");
print("calc sub 6-4 = ", c, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// counter: 1 2 3
// accumulator total: 35
// adder(10)(7) = 17
// calc add 6+4 = 10
// calc mul 6*4 = 24
// calc sub 6-4 = 2
// __END_VM_OUT__

