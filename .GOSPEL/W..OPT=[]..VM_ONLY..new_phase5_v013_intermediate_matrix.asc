// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * INTERMEDIATE / matrix multiplication
 * Multiplies two 3x3 matrices stored as tables of tables and prints the result,
 * then multiplies a matrix by the identity to show it is unchanged.
 * Exercises nested tables and triple-nested loops.
 *
 * Expected output:
 *   A x B =
 *     30 24 18
 *     84 69 54
 *     138 114 90
 *   A x I == A : true
 */

function makeZero(n) {
	m = [];
	for (i = 0; i < n; ++i) {
		m[i] = [];
		for (j = 0; j < n; ++j)
			m[i][j] = 0;
	}
	return m;
}

function multiply(a, b, n) {
	c = makeZero(n);
	for (i = 0; i < n; ++i)
		for (j = 0; j < n; ++j) {
			s = 0;
			for (k = 0; k < n; ++k)
				s = s + a[i][k] * b[k][j];
			c[i][j] = s;
		}
	return c;
}

function printMatrix(m, n) {
	for (i = 0; i < n; ++i) {
		for (j = 0; j < n; ++j)
			print(" ", m[i][j]);
		print("\n");
	}
}

function equalMatrix(a, b, n) {
	for (i = 0; i < n; ++i)
		for (j = 0; j < n; ++j)
			if (a[i][j] != b[i][j])
				return false;
	return true;
}

N = 3;

A = [
	[ 1, 2, 3 ],
	[ 4, 5, 6 ],
	[ 7, 8, 9 ]
];

B = [
	[ 9, 8, 7 ],
	[ 6, 5, 4 ],
	[ 3, 2, 1 ]
];

I = [
	[ 1, 0, 0 ],
	[ 0, 1, 0 ],
	[ 0, 0, 1 ]
];

AB = multiply(A, B, N);
print("A x B =\n");
printMatrix(AB, N);

AI = multiply(A, I, N);
same = equalMatrix(AI, A, N);
print("A x I == A : ", same, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// A x B =
//   30 24 18
//   84 69 54
//   138 114 90
// A x I == A : true
// __END_VM_OUT__

