// __CMP_RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
// named function with params and return
function add(a, b) {
    return a + b;
}

// anonymous function called immediately
(function(x, y) {
    return x + y;
})(1, 2);

// nested function definitions
function outer(x) {
    function inner(y) {
        return y;
    }
    return inner(x);
}

// function call as argument (nested calls)
add(add(1, 2), add(3, 4));

// chained calls (each call returns something callable)
foo(1)(2)(3);

// method call
obj..method(a, b);

// member that is a function, called
obj.getFunc()(arg);
obj[key](1, 2, 3);

// anonymous function with conditional returns
(function() {
    if(x > 0)
        return x;
    return 0;
})();

// anonymous function with no params, chained call
(function(){})()(1);





