// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / arithmetic
 * Targets: ADD, SUB, MUL, DIV, MOD and operator precedence.
 *
 *   100              a + b
 * +  58              b - a + 42
 * + 5040             7 * 8 * 9 * 10
 * +  12.5            100 / 8
 * +   3              17 % 7
 * +  14              2 + 3 * 4            (precedence)
 * +  50              (2 + 3) * (4 + 6)    (parens)
 * +   1              (10 - 2*3) / (8/2)   (nested)
 * -   7              3 - 2 * 5            (unary/negative result)
 * +1000              10*10*10 + 5*5*5 - 25*5
 * = 6271.5
 *
 * Expected output:
 *   arithmetic total = 6_271.5
 */

total =   (42 + 58)
        + (58 - 42 + 42)
        + (7 * 8 * 9 * 10)
        + (100 / 8.0f)
        + (17 % 7)
        + (2 + 3 * 4)
        + ((2 + 3) * (4 + 6))
        + ((10 - 2 * 3) / (8 / 2))
        + (3 - 2 * 5)
        + (10 * 10 * 10 + 5 * 5 * 5 - 25 * 5);

print("arithmetic total = ", total, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// arithmetic total = 6271.5
// __END_VM_OUT__

