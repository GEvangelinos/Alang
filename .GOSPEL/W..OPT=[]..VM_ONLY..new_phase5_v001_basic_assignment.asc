// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / assignment, pre/post increment and decrement
 * Targets: ASSIGN plus the desugaring of ++/-- into ADD/SUB. Each effect is
 * captured as a number and summed.
 *
 *    7                x = 7
 * + 27                a = b = c = 9  -> a+b+c
 * + 11                post-inc:  old(5) + n(6)
 * + 12                pre-inc:   val(6) + n(6)
 * + 11                post-dec:  old(6) + n(5)
 * + 10                pre-dec:   val(5) + n(5)
 * + 20                build-up:  (0+5)*4
 * = 98
 *
 * Expected output:
 *   assignment total = 98
 */

x = 7;
a = b = c = 9;

n = 5;  pi_old = n++;  pi_n = n;     // post-inc:  5, then 6
m = 5;  pr_val = ++m;  pr_m = m;     // pre-inc:   6, then 6
p = 6;  pd_old = p--;  pd_p = p;     // post-dec:  6, then 5
q = 6;  pr2_val = --q; pr2_q = q;    // pre-dec:   5, then 5

build = 0;
build = build + 5;
build = build * 4;                   // 20

total =   x
        + (a + b + c)
        + (pi_old + pi_n)
        + (pr_val + pr_m)
        + (pd_old + pd_p)
        + (pr2_val + pr2_q)
        + build;

print("assignment total = ", total, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// assignment total = 98
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
