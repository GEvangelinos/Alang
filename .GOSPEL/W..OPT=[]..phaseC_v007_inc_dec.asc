// __RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
// Prefix and postfix on plain variables
a = ++x;
x++;
--y;
b = y--;

// Prefix and postfix on table members (adds TABLE_GET_ELEM + TABLE_SET_ELEM)
++a[0];
a[0]++;
--a.k;
a.k--;
// __END_SOURCE__

