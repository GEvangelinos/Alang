// __RUN__: %DRIVER --source %SELF %ERROR_MODE --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
// Error: Can't have break/continue outside of loop.
{
    break;
    {
        continue;
    }
}

while(true){
    // Legal
    break; continue;

    function foo(){
        // Error: "Special" case, funcdeclare inside while, *NOT* inside a loop here
        break;
        continue;

        while(false){
            // Legal
            break;
            continue;
        }
    }

    // Legal: special case, checks if loop counter is being kept after funcdeclare (should reset when opening func and restore when finishing funcbody), -0.3 if this doesn't work
    break;
}
// __END_SOURCE__

// __BEGIN_DIAGNOSTICS__
// code,line,column,issue_type
