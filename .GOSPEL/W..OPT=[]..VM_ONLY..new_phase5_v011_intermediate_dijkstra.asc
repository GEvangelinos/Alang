// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * INTERMEDIATE / Dijkstra's shortest paths
 * Single-source shortest paths on a small weighted graph given as an adjacency
 * matrix (a table of tables). A large sentinel stands in for "no edge" /
 * "infinity". Exercises nested tables, loops and a classic algorithm.
 *
 * Edges (undirected): 0-1:7  0-5:9  1-2:9  1-5:14  2-3:11  3-4:6  4-5:9
 *
 * Expected output (shortest distance from vertex 0):
 *   to 0 = 0
 *   to 1 = 7
 *   to 2 = 16
 *   to 3 = 24
 *   to 4 = 18
 *   to 5 = 9
 */

INF = 100000;
N = 6;

// Symmetric adjacency matrix; 0 on the diagonal, INF where there is no edge.
g = [
	[ 0,  7,  INF, INF, INF, 9   ],
	[ 7,  0,  9,   INF, INF, 14  ],
	[ INF,9,  0,   11,  INF, INF ],
	[ INF,INF,11,  0,   6,   INF ],
	[ INF,INF,INF, 6,   0,   9   ],
	[ 9,  14, INF, INF, 9,   0   ]
];

dist = [];
visited = [];
for (i = 0; i < N; ++i) {
	dist[i] = INF;
	visited[i] = false;
}
dist[0] = 0;

for (count = 0; count < N; ++count) {
	// Pick the nearest unvisited vertex.
	u = -1;
	best = INF + 1;
	for (v = 0; v < N; ++v) {
		if (not visited[v] and dist[v] < best) {
			best = dist[v];
			u = v;
		}
	}

	if (u == -1)
		break;                       // remaining vertices unreachable

	visited[u] = true;

	// Relax all edges out of u.
	for (w = 0; w < N; ++w) {
		edge = g[u][w];
		if (edge < INF and not visited[w]) {
			alt = dist[u] + edge;
			if (alt < dist[w])
				dist[w] = alt;
		}
	}
}

print("shortest distance from vertex 0:\n");
for (i = 0; i < N; ++i)
	print("  to ", i, " = ", dist[i], "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// shortest distance from vertex 0:
// to 0 = 0
// to 1 = 7
// to 2 = 16
// to 3 = 24
// to 4 = 18
// to 5 = 9
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
