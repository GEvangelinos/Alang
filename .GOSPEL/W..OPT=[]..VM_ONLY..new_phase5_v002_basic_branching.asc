// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / branching
 * Targets: if / else / else-if chains. Each function's result is stored first
 * (one call per statement), then all of them are checked in one boolean.
 *
 * Expected output:
 *   branching all correct = true
 */

function sign(n) {
	if (n < 0)
		return "negative";
	else if (n == 0)
		return "zero";
	else
		return "positive";
}

function grade(score) {
	if (score >= 90)      return "A";
	else if (score >= 80) return "B";
	else if (score >= 70) return "C";
	else if (score >= 60) return "D";
	else                  return "F";
}

function nested(p, q) {
	if (p > 0)
		if (q > 0)
			return "both";
		else
			return "only-p";
	else
		return "neither";
}

s1 = sign(-4);
s2 = sign(0);
s3 = sign(9);
g1 = grade(95);
g2 = grade(72);
g3 = grade(40);
n1 = nested(4, 6);

ok =     (s1 == "negative")
     and (s2 == "zero")
     and (s3 == "positive")
     and (g1 == "A")
     and (g2 == "C")
     and (g3 == "F")
     and (n1 == "both");

print("branching all correct = ", ok, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// branching all correct = true
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
