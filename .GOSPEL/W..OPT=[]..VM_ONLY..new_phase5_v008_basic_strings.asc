// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / strings
 * Targets: string equality (== / !=) and escape sequences handled by the lexer.
 * The equality checks fold into one boolean; a second line shows escapes
 * rendering.
 *
 *
 * Expected output:
 *   strings all correct = true
 *   escapes: tab[	] quote["] end
 */

hello = "Hello";
same  = "Hello";

ok =     (hello == same)
     and ("abc" == "abc")
     and ("abc" != "abd")
     and (not ("x" == "y"))
     and ("" != "nonempty");

print("strings all correct = ", ok, "\n");
// Escape sequences render in the output (tab and a literal quote).
print("escapes: tab[\t] quote[\"] end\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// strings all correct = true
// escapes: tab[	] quote["] end
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
