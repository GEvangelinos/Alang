// arith inside relational
x + 1 > y - 2;
x * 3 >= z / 4;
a % 2 == 0;

// relational inside boolean
x > 0 and y < 10;
a == b or c != d;
not x >= 5;

// precedence chains: arith > relational > equality > and > or
x + 1 > y * 2 and a - 3 < b % 5 or not z >= 0;
a * b + c / d - e % f > g and not h == i or j <= k and l != m;

// unary minus inside relational inside boolean
-x > -y and not -z == 0;

// not applied to comparison
not a > b or not c == d;





