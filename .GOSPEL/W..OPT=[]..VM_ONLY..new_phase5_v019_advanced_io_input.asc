// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * ADVANCED / mandatory library -- input()
 * Reads several values from stdin and reports the type input() inferred for
 * each. input() recognises numbers, the literals true/false/nil, and otherwise
 * yields a string. Run with the accompanying io_input.in fed on stdin:
 *
 *   ./VM/vm out.bin < tests/vm/advanced/io_input.in
 *
 * io_input.in supplies, one per line:  42   3.14   true   false   nil   hello
 *
 * Expected output (input() prints its own "Input: " prompt before each read,
 * so they appear inline -- the two leading prompts are the two reads that happen
 * before the first print):
 *   Input: Input: read a number, type number, value 42
 *   read a number, type number, value 3.14
 *   doubled first two: 90.28
 *   Input: read true,  type bool, value true
 *   Input: read false, type bool, value false
 *   Input: read nil,   type nil, value nil
 *   Input: read word,  type string, value hello
 */

a = input();
b = input();
print("read a number, type ", typeof(a), ", value ", a, "\n");
print("read a number, type ", typeof(b), ", value ", b, "\n");
print("doubled first two: ", a * 2 + b * 2, "\n");

t = input();
print("read true,  type ", typeof(t), ", value ", t, "\n");

f = input();
print("read false, type ", typeof(f), ", value ", f, "\n");

n = input();
print("read nil,   type ", typeof(n), ", value ", n, "\n");

w = input();
print("read word,  type ", typeof(w), ", value ", w, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// read a number, type INT, value 42
// read a number, type FLOAT, value 3.14
// doubled first two: 90.28
// read true,  type BOOL, value true
// read false, type BOOL, value false
// read nil,   type NIL, value nil
// read word,  type STRING, value hello
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__

// __BEGIN_VM_IN__
// 42
// 3.14
// true
// false
// nil
// hello
// __END_VM_IN__

