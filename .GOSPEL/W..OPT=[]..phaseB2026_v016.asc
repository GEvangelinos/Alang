// __BEGIN_SOURCE__
// declare at global scope first, then reference via ::
globalX = 100;
::globalX = 200;

// arith + relational + boolean all at once
::globalX + 2 * 3 > 10 and not ::globalX == 0 or ::globalX != 100;

// object definitions
table = [{ "k1" : 1 }, { "k2" : true }];
arr = [1, 2 * 2, not false, nil, "hi"];

// function with formal params, local vars, loops, branches, return
function processAll(items, limit) {
    local count = 0;

    for(; count < limit; count++) {
        if(items[count] > 0 and not items[count] == limit) {
            items[count] = items[count] * 2;
        } else {
            break;
        }
    }

    while(count > 0) {
        if(count % 2 == 0)
            continue;
        --count;
    }

    return count;
}

// anonymous function with complex args
(function(a, b) { return a + b; })(::globalX, -2);

// chained member access + method call + call result used in expr
arr..push(processAll(arr, 10));
table[0].getResult()(1, 2).value;





