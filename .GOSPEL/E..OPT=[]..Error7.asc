// __RUN__: %DRIVER --source %SELF %ERROR_MODE --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
function foo(){
   x=0;
}
foo = 4;	//Using ProgramFunc as an lvalue
print = foo;	//Using LibFunc as an lvalue
++print;	//Using LibFunc as an lvalue
foo--;		//Using ProgramFunc as an lvalue
// __END_SOURCE__

// __BEGIN_DIAGNOSTICS__
// code,line,column,issue_type
// ASSIGN_TO_FUNC,4,1,error
// ASSIGN_TO_FUNC,1,1,note
// ASSIGN_TO_LIBFUNC,5,1,error
// OPERATOR_REQUIRES_LVALUE,6,1,error
// OPERATOR_REQUIRES_LVALUE,7,1,error
// __END_DIAGNOSTICS__

