// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * INTERMEDIATE / N-Queens (solution counter + one printed board)
 * Counts every way to place N non-attacking queens on an NxN board via
 * backtracking, and prints the first solution found.
 *
 * Expected output:
 *   solutions for N=4: 2
 *   solutions for N=6: 4
 *   solutions for N=8: 92
 *   one solution for N=8:
 *    Q . . . . . . .
 *    . . . . Q . . .
 *    . . . . . . . Q
 *    . . . . . Q . .
 *    . . Q . . . . .
 *    . . . . . . Q .
 *    . Q . . . . . .
 *    . . . Q . . . .
 */

count = 0;
firstBoard = 0;        // will hold a copy of the column array for the first hit

// col[r] = column of the queen on row r. 'placed' rows are 0..row-1.
function safe(col, row, c) {
	for (r = 0; r < row; ++r) {
		cc = col[r];
		if (cc == c)
			return false;              // same column
		d = row - r;
		if (cc == c - d or cc == c + d)
			return false;              // same diagonal
	}
	return true;
}

function snapshot(col, n) {
	copy = [];
	for (r = 0; r < n; ++r)
		copy[r] = col[r];
	return copy;
}

function solve(col, row, n) {
	if (row == n) {
		::count = ::count + 1;
		if (not ::firstBoard)              // 0 until the first solution is stored
			::firstBoard = snapshot(col, n);
		return;
	}
	for (c = 0; c < n; ++c) {
		if (safe(col, row, c)) {
			col[row] = c;
			solve(col, row + 1, n);
		}
	}
}

function countSolutions(n) {
	::count = 0;
	::firstBoard = 0;
	board = [];
	for (r = 0; r < n; ++r)
		board[r] = -1;
	solve(board, 0, n);
	return ::count;
}

s4 = countSolutions(4);
print("solutions for N=4: ", s4, "\n");

s6 = countSolutions(6);
print("solutions for N=6: ", s6, "\n");

s8 = countSolutions(8);
print("solutions for N=8: ", s8, "\n");

print("one solution for N=8:\n");
for (r = 0; r < 8; ++r) {
	for (c = 0; c < 8; ++c) {
		if (firstBoard[r] == c)
			print(" Q");
		else
			print(" .");
	}
	print("\n");
}
// __END_SOURCE__

// __BEGIN_VM_OUT__
// solutions for N=4: 2
// solutions for N=6: 4
// solutions for N=8: 92
// one solution for N=8:
//  Q . . . . . . .
//  . . . . Q . . .
//  . . . . . . . Q
//  . . . . . Q . .
//  . . Q . . . . .
//  . . . . . . Q .
//  . Q . . . . . .
//  . . . Q . . . .
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
