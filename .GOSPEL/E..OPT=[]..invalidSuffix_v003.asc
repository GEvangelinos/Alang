// __CMP_RUN__: %DRIVER %ERROR_MODE --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __DESC__: Comprehensive test suite for invalid integer literal suffixes across all lexical, boundary, and operator collision edge cases.
// __AI_GENERATED__

// __BEGIN_SOURCE__
// 1. Single-character invalid decimal suffixes (lower/upper)
v0 = 1d;                   // Value: 1, Suffix: "d" (single lowercase char)
v1 = 2K;                   // Value: 2, Suffix: "K" (single uppercase char)
v2 = 333d;                 // Value: 333, Suffix: "d" (multi-digit base, single lowercase)
v3 = 444K;                 // Value: 444, Suffix: "K" (multi-digit base, single uppercase)

// 2. Multi-character identifier decimal suffixes
v4 = 1invalid;             // Value: 1, Suffix: "invalid" (single-digit base, multi-char ID)
v5 = 2suffix;              // Value: 2, Suffix: "suffix" (single-digit base, multi-char ID)
v6 = 333invalid;           // Value: 333, Suffix: "invalid" (multi-digit base, multi-char ID)
v7 = 444suffix;            // Value: 444, Suffix: "suffix" (multi-digit base, multi-char ID)

// 3. Trailing/internal underscore identifier suffixes
v8 = 1suffix_;             // Value: 1, Suffix: "suffix_" (trailing underscore in suffix)
v9 = 42bad_ident_;         // Value: 42, Suffix: "bad_ident_" (mixed snake_case with trailing underscore)

// 4. Zero and leading-zero decimal literals
v10 = 0u;                  // Value: 0, Suffix: "u" (single-digit zero base with single-char suffix)
v11 = 0bad;                // Value: 0, Suffix: "bad" (single-digit zero base with multi-char ID)
v12 = 007invalid;          // Value: 7, Suffix: "invalid" (leading zeroes consumed in base 10)

// 5. Hexadecimal literals with invalid suffixes
v13 = 0x0z;                // Value: 0x0 (0), Suffix: "z" (hex zero base, lowercase prefix/suffix)
v14 = 0X0Z;                // Value: 0X0 (0), Suffix: "Z" (hex zero base, uppercase prefix/suffix)
v15 = 0x1Akg;              // Value: 0x1A (26), Suffix: "kg" (mixed alpha hex digits followed by non-hex ID)
v16 = 0xFFinvalid;         // Value: 0xFF (255), Suffix: "invalid" (uppercase hex digits followed by multi-char ID)
v17 = 0XDEADBEEFcustom;    // Value: 0XDEADBEEFc (59774856956), Suffix: "ustom" ('c' is a valid hex digit and consumed by base 16)

// 6. Hexadecimal collision cases (valid hex digits transitioning into non-hex ID chars)
v18 = 0x123abc_tail;       // Value: 0x123abc (1194684), Suffix: "_tail" (transition from valid hex 'c' to underscore)
v19 = 0xCAFEg;             // Value: 0xCAFE (51966), Suffix: "g" (transition from valid hex 'E' to non-hex letter 'g')

// 7. Expressions without whitespace (operator and delimiter boundary tests)
v20 = 10d+20k;             // Term 1: Value 10, Suffix "d"; Term 2: Value 20, Suffix "k" (stops suffix at '+' operator)
v21 = (30invalid)*2;       // Value: 30, Suffix: "invalid" (stops suffix at ')' delimiter)
v22 = [40bad, 50bad];      // Element 1: Value 40, Suffix "bad" (stops at ','); Element 2: Value 50, Suffix "bad" (stops at ']')
// __END_SOURCE__

