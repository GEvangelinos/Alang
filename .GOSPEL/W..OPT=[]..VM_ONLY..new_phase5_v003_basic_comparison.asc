// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / comparison
 * Targets: IF_LESS, IF_LESSEQ, IF_GREATER, IF_GREATEREQ, IF_EQ, IF_NOTEQ and the
 * nil/bool comparison rules. Each comparison is asserted in one big 'and' chain;
 * if every rule holds, the whole thing is true.
 *
 * Expected output:
 *   comparison all correct = true
 */

NIL = nil;
ok =     (3 < 5)
     and (not (5 < 3))
     and (5 <= 5)
     and (7 > 2)
     and (not (2 >= 9))
     and (4 == 4)
     and (not (4 == 5))
     and (4 != 5)
     and (nil == nil)            // nil equals only nil
     and (not (NIL == 0))        // nil is not 0 // Note my compiler does allow `nil == 0` it comparison between invalid types. only because we passed nil onto a runtime variable.. we where able to do this comparison.
     and (true == 1)             // bool coerces the other side to truthiness
     and (false == 0);

print("comparison all correct = ", ok, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// comparison all correct = true
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
