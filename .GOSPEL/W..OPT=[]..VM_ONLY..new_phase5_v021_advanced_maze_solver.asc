//  members of [10,20,30]      : 3
//  members of record          : 2
//  keys count                 : 2
//  sqrt(144)         : 12
//  sqrt(2)           : 1.4142135623730951
//  sqrt(-1)          : nil
//  cos(0)/cos(60)    : 1 0.5
//  sin(30)/sin(90)   : 0.5 1
