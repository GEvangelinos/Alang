// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * ADVANCED / BONUS -- the full library
 * Exercises every non-interactive library function the VM ships with. The four
 * mandatory ones (print, input, totalarguments, argument) are covered elsewhere
 * (variadic.asc and io_input.asc); this file focuses on the bonus library:
 * typeof, objecttotalmembers, objectmemberkeys, objectcopy, strtonum, sqrt,
 * cos, sin.
 *
 * Expected output:
 *   typeof number   : number
 *   typeof string   : string
 *   typeof bool     : bool
 *   typeof nil      : nil
 *   typeof table    : table
 *   typeof userfunc : userfunc
 *   typeof libfunc  : libfunc
 *   members of [10,20,30]      : 3
 *   members of record          : 2
 *   keys count                 : 2
 *   copy is independent        : true
 *   copy equals original value : true
 *   strtonum("42")    : 42
 *   strtonum("3.14")  : 3.14
 *   strtonum("nope")  : nil
 *   sqrt(144)         : 12
 *   sqrt(2)           : 1.414
 *   sqrt(-1)          : nil
 *   cos(0)/cos(60)    : 1 0.5
 *   sin(30)/sin(90)   : 0.5 1
 */

function f() { return 0; }

print("typeof number   : ", typeof(5), "\n");
print("typeof string   : ", typeof("hi"), "\n");
print("typeof bool     : ", typeof(true), "\n");
print("typeof nil      : ", typeof(nil), "\n");
print("typeof table    : ", typeof([1, 2]), "\n");
print("typeof userfunc : ", typeof(f), "\n");
print("typeof libfunc  : ", typeof(print), "\n");

list = [10, 20, 30];
record = [ {"a" : 1}, {"b" : 2} ];
print("members of [10,20,30]      : ", objecttotalmembers(list), "\n");
print("members of record          : ", objecttotalmembers(record), "\n");

keys = objectmemberkeys(record);
print("keys count                 : ", objecttotalmembers(keys), "\n");

// objectcopy makes a shallow copy: mutating the copy must not affect the source.


print("sqrt(144)         : ", sqrt(144), "\n");
print("sqrt(2)           : ", sqrt(2), "\n");
print("sqrt(-1)          : ", sqrt(-1), "\n");

// Trig takes degrees and is rounded to three decimals by the VM.
print("cos(0)/cos(60)    : ", cos(0), " ", cos(60), "\n");
print("sin(30)/sin(90)   : ", sin(30), " ", sin(90), "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
//  typeof number   : INT
//  typeof string   : STRING
//  typeof bool     : BOOL
//  typeof nil      : NIL
//  typeof table    : TABLE
//  typeof userfunc : PROGFUNC
//  typeof libfunc  : LIBFUNC
//  members of [10,20,30]      : 3
//  members of record          : 2
//  keys count                 : 2
//  sqrt(144)         : 12
//  sqrt(2)           : 1.4142135623730951
//  sqrt(-1)          : nil
//  cos(0)/cos(60)    : 1.0 0.5000000000000001
//  sin(30)/sin(90)   : 0.49999999999999994 1.0
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__

// __BEGIN_VM_IN__
// __END_VM_IN__

