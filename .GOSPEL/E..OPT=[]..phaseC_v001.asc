// __CMP_RUN__: %DRIVER --source %SELF %ERROR_MODE --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
function foo(){}

// Error: can't get member of function symbol (can only get from table)
foo.a;

// Error: same
print.a;

foo();

// Error: same
foo..a();

// Error: same
input[a];

// Error: same
foo[g];
// __END_SOURCE__

