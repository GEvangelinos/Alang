// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
    Test file for the final phase of HY-340: Languages & Compilers
    Computer science dpt, University of Crete, Greece

    Expected Output:
	123
	true false true
	true
	false

*/

nl = "\n";

a = 1;

b = 2;

c = 3;

print(a,b,c,nl);

d = b < c; //true

e = not a == b; //false

f = c >= d or b != 1; //true

print(d, " ", e, " ", f, nl);

f = e >= d and c != b or not( c > a); //true

print(f, nl);

f = not f; //false

print(f, nl);
// __END_SOURCE__

// __BEGIN_VM_OUT__
// 123
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// [27:5] Non number in arithmetic operation
// __END_VM_ERR__
