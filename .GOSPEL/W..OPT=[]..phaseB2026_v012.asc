// __RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
function foo(a, b){}

foo();

foo()(1)(2, true);

(function(){})();

x;
x..f();

x[f].g();




/*
Expected output:
===========================================
                SYMBOL TABLE
===========================================

        ----- Scope 0 (Global) -----

Name                 Type            Line
-------------------------------------------
f                    GLOBALVAR       12
x                    GLOBALVAR       9
typeof               LIBFUNC
foo                  USERFUNC        1
input                LIBFUNC
strtonum             LIBFUNC
sin                  LIBFUNC
_f0                  USERFUNC        7
cos                  LIBFUNC
objectcopy           LIBFUNC
objecttotalmembers   LIBFUNC
objectmemberkeys     LIBFUNC
argument             LIBFUNC
sqrt                 LIBFUNC
print                LIBFUNC
totalarguments       LIBFUNC

            ----- Scope 1 -----

Name                 Type            Line
-------------------------------------------
a                    FORMALVAR       1
b                    FORMALVAR       1

===========================================
*/
// __END_SOURCE__

