// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * BASIC / functions
 * Targets: CALL, FUNCENTER, FUNCEXIT, PUSHARG, return values, functions as
 * values and as arguments. Each result is stored first (one call per
 * statement), then verified in one boolean.
 *
 * Expected output:
 *   functions all correct = true
 */

function f()        { return "hello from f"; }
function dbl(x)     { return x * 2; }
function add(a, b)  { return a + b; }
function max3(a, b, c) {
	m = a;
	if (b > m) m = b;
	if (c > m) m = c;
	return m;
}
function classify(n) {
	if (n < 10) return "small";
	return "big";
}
function apply(fn, v) { return fn(v); }

square = (function(n) { return n * n; });

r1 = f();
r2 = dbl(42);
r3 = add(10, 20);
r4 = max3(4, 9, 2);
r5 = classify(3);
r6 = square(5);
r7 = apply(dbl, 5);

ok =     (r1 == "hello from f")
     and (r2 == 84)
     and (r3 == 30)
     and (r4 == 9)
     and (r5 == "small")
     and (r6 == 25)
     and (r7 == 10);

print("functions all correct = ", ok, "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// functions all correct = true
// __END_VM_OUT__

// __BEGIN_VM_ERR__
// __END_VM_ERR__
