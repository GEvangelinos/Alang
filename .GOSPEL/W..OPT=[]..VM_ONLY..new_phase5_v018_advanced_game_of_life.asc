/*
 * ADVANCED / Conway's Game of Life
 * A glider crawling across a grid. The grid is a table of tables of 0/1 cells;
 * each generation is computed from the previous one with the standard rules.
 * Exercises nested tables, neighbour counting with bounds checks, and a fair
 * amount of looping -- and it is genuinely fun to watch evolve.
 *
 * Rules: a live cell with 2 or 3 live neighbours survives; a dead cell with
 * exactly 3 live neighbours becomes alive; everything else dies / stays dead.
 *
 * The expected output is the twenty generations printed below (a glider moving
 * one cell down-and-right every four generations).
 */

W = 10;
H = 8;

function makeGrid() {
	g = [];
	for (y = 0; y < H; ++y) {
		g[y] = [];
		for (x = 0; x < W; ++x)
			g[y][x] = 0;
	}
	return g;
}

function printGrid(g, gen) {
	print("generation ", gen, ":\n");
	for (y = 0; y < H; ++y) {
		for (x = 0; x < W; ++x) {
			if (g[y][x])
				print("#");
			else
				print(".");
		}
		print("\n");
	}
	print("\n");
}

function liveNeighbours(g, cx, cy) {
	n = 0;
	for (dy = -1; dy <= 1; ++dy) {
		for (dx = -1; dx <= 1; ++dx) {
			if (dx == 0 and dy == 0)
				continue;
			nx = cx + dx;
			ny = cy + dy;
			if (nx >= 0 and nx < W and ny >= 0 and ny < H)
				if (g[ny][nx])
					n = n + 1;
		}
	}
	return n;
}

function step(g) {
	next = makeGrid();
	for (y = 0; y < H; ++y) {
		for (x = 0; x < W; ++x) {
			alive = g[y][x];
			cnt = liveNeighbours(g, x, y);
			if (alive) {
				if (cnt == 2 or cnt == 3)
					next[y][x] = 1;
			} else {
				if (cnt == 3)
					next[y][x] = 1;
			}
		}
	}
	return next;
}

grid = makeGrid();
// A glider near the top-left corner.
grid[0][1] = 1;
grid[1][2] = 1;
grid[2][0] = 1;
grid[2][1] = 1;
grid[2][2] = 1;

for (gen = 0; gen < 20; ++gen) {
	printGrid(grid, gen);
	grid = step(grid);
}


