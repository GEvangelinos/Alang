// __BEGIN_SOURCE__
// NOTE: division by zero is a compile-time WARNING (not fatal):
RESULT = 10 / 0;                            // warning: division by zero (int)
RESULT = 10.0 / 0.0;                        // warning: division by zero (float)
RESULT = 5 / (2 - 2);                       // warning: division by zero (folded expression)
// __END_SOURCE__

// __BEGIN_IR__
// quad_no,opcode,result,arg1,arg2,label,first_lineno,last_lineno
