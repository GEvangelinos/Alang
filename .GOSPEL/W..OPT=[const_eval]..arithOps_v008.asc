// 3,div,$0,10f,0f,NA,3,3
// 4,assign,RESULT,$0,NA,NA,3,3
// 5,div,$0,5,0,NA,4,4
// 6,assign,RESULT,$0,NA,NA,4,4
// __END_IR__

