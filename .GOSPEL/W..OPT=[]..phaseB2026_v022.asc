// __RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
// while with if/else inside
while(x > 0) {
    if(x > 5)
        x--;
    else
        x++;
}

// for inside if
if(flag) {
    for(; i < 10; i++) {
        x = x + i;
    }
}

// else-if chain (else whose stmt is another ifstmt)
if(x > 10) {
    x = 10;
} else if(x < 0) {
    x = 0;
} else {
    x = x + 1;
}

// while with break/continue guarded by if
while(true) {
    if(x > 100)
        break;
    if(x % 2 == 0)
        continue;
    x++;
}

// triple nesting: if -> while -> for
if(start) {
    while(running) {
        for(; step > 0; step--) {
            if(step == 5)
                continue;
            else
                break;
        }
    }
}

