// __CMP_RUN__: %SKIP %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics
// __VM_RUN__: %DRIVER --source %SELF

// __BEGIN_SOURCE__
/*
 * ADVANCED / mandatory library functions -- variadic functions
 * Uses totalarguments() and argument(i) (both mandatory) to build functions
 * that accept any number of arguments: sum, product, max and average.
 *
 * NOTE: this VM's argument(i) returns the i-th actual as a NUMBER, so variadic
 * helpers here are deliberately numeric.
 *
 * Expected output:
 *   sum()              = 0
 *   sum(1,2,3,4,5)     = 15
 *   sum(10,20,30)      = 60
 *   product(1..5)      = 120
 *   max(3,9,2,7,5)     = 9
 *   max(-4,-1,-8)      = -1
 *   average(2,4,6,8)   = 5
 *   count of args      = 4
 */

function sum() {
	local n = totalarguments();
	local total = 0;
	for (local i = 0; i < n; ++i)
		total = total + argument(i);
	return total;
}

function product() {
	local n = totalarguments();
	local p = 1;
	for (local i = 0; i < n; ++i)
		p = p * argument(i);
	return p;
}

function max() {
	local n = totalarguments();
	if (n == 0)
		return nil;
	local best = argument(0);
	for (local i = 1; i < n; ++i) {
		local v = argument(i);
		if (v > best)
			best = v;
	}
	return best;
}

function average() {
	local n = totalarguments();
	if (n == 0)
		return nil;
	local total = 0;
	for (local i = 0; i < n; ++i)
		total = total + argument(i);
	return total / n;
}

function countArgs() {
	return totalarguments();
}

print("sum()              = ", sum(), "\n");
print("sum(1,2,3,4,5)     = ", sum(1, 2, 3, 4, 5), "\n");
print("sum(10,20,30)      = ", sum(10, 20, 30), "\n");
print("product(1..5)      = ", product(1, 2, 3, 4, 5), "\n");
print("max(3,9,2,7,5)     = ", max(3, 9, 2, 7, 5), "\n");
print("max(-4,-1,-8)      = ", max(-4, -1, -8), "\n");
print("average(2,4,6,8)   = ", average(2, 4, 6, 8), "\n");
print("count of args      = ", countArgs(1, 2, 3, 4), "\n");
// __END_SOURCE__

// __BEGIN_VM_OUT__
// sum()              = 0
// sum(1,2,3,4,5)     = 15
// sum(10,20,30)      = 60
// product(1..5)      = 120
// max(3,9,2,7,5)     = 9
// max(-4,-1,-8)      = -1
// average(2,4,6,8)   = 5
// count of args      = 4
// __END_VM_OUT__

