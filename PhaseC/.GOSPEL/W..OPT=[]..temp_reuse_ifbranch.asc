// Scope 0: a,b,c, Scope 1: d
// Weird mechanics of alpha...
// as normally you would expect b and d to be one same level/scope
if (a+a)
    b+b; // Temp  produced here should be $0

if (c+c)
{
    d+d;
}
// __END_SOURCE__

