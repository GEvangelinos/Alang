// strtonum,LIBRARY_FUNCTION,0,0
// sqrt,LIBRARY_FUNCTION,0,0
// cos,LIBRARY_FUNCTION,0,0
// sin,LIBRARY_FUNCTION,0,0
// RESULT,GLOBAL_VARIABLE,5,0
// __END_SYMBOL_TABLE__

