// __RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics --opt_const_eval

// __BEGIN_SOURCE__
// We calculate division up to div with 0, then we emit div quad to give control to
// virtual machine for division. Division by 1 is trimmed even though lhs
// is $0 (variable) and then we emit temp for div with 3

RESULT = 100/2/4/0/1/1/3; // <- int div
RESULT = 100/2/4.0/0/1/1/3; // <- float div
// __END_SOURCE__

// __BEGIN_IR__
// quad_no,opcode,result,arg1,arg2,label,first_lineno,last_lineno
// 1,div,$0,12,0,NA,5,5
// 2,div,$0,$0,3,NA,5,5
// 3,assign,RESULT,$0,NA,NA,5,5
// 4,div,$0,12.500000,0,NA,6,6
// 5,div,$0,$0,3,NA,6,6
// 6,assign,RESULT,$0,NA,NA,6,6
// __END_IR__

// __BEGIN_SYMBOL_TABLE__
// symbol,type,line,scope
// print,LIBRARY_FUNCTION,0,0
// input,LIBRARY_FUNCTION,0,0
// objectmemberkeys,LIBRARY_FUNCTION,0,0
// objecttotalmembers,LIBRARY_FUNCTION,0,0
// objectcopy,LIBRARY_FUNCTION,0,0
// totalarguments,LIBRARY_FUNCTION,0,0
// argument,LIBRARY_FUNCTION,0,0
