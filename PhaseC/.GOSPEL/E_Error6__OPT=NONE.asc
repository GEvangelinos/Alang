// __RUN__: %DRIVER --source %SELF %ERROR_MODE --export_ir --export_symbol_table_without_temps --export_diagnostics

// __BEGIN_SOURCE__
//
i = 8;
x = 10;
y = 30;

function foo(x,y){
    x = i;
    ::y = x;

    function g() {
		::x = x;   //Error Cannot access x inside g
		::y = y;   //Error Cannot access y inside g
    }
}
// __END_SOURCE__

// __BEGIN_DIAGNOSTICS__
// code,line,column,issue_type
// INACCESSIBLE_VAR_IN_FUNC,11,9,error
// INACCESSIBLE_VAR_IN_FUNC,10,5,note
// INACCESSIBLE_VAR_IN_FUNC,6,14,note
// INACCESSIBLE_VAR_IN_FUNC,12,9,error
// INACCESSIBLE_VAR_IN_FUNC,10,5,note
// INACCESSIBLE_VAR_IN_FUNC,6,16,note
