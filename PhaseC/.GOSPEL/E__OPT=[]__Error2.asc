// __BEGIN_SOURCE__
//

function G(){
       function F(){
                       return G();
       }
}
return G();	//Use of 'return' while not in a function
break;		//Use of 'break' while not in a loop
continue;	//Use of 'continue' while not in a loop
// Break / Continue / Return in scope != 0
{
	{
		{
			return G();
			break;
			continue;
		}
	}
}

// __END_SOURCE__

