// __RUN__: %DRIVER --source %SELF --export_ir --export_symbol_table_without_temps --export_diagnostics --opt_const_eval

// __BEGIN_SOURCE__
// === FLOAT FOLDING ===
f1 = 3.5 + 2.5;      // expect: f1 = 6.0
f2 = 10.0 - 7.5;     // expect: f2 = 2.5
f3 = 6.0 * 0.5;      // expect: f3 = 3.0
f4 = 20.0 / 4.0;     // expect: f4 = 5.0
f5 = 10 / 4.0;       // expect: f5 = 2.5
f6 = 10.0 / 4;       // expect: f6 = 2.5
// __END_SOURCE__

// __BEGIN_IR__
// quad_no,opcode,result,arg1,arg2,label,first_lineno,last_lineno
// 1,assign,f1,6f,NA,NA,2,2
// 2,assign,f2,2.5f,NA,NA,3,3
// 3,assign,f3,3f,NA,NA,4,4
// 4,assign,f4,5f,NA,NA,5,5
// 5,assign,f5,2.5f,NA,NA,6,6
// 6,assign,f6,2.5f,NA,NA,7,7
// __END_IR__

