%{
        #define INSIDE_FLEX_FILE

        #include <iostream>
        #include "alphaDefs.hpp" 
        #include "alphaLang.hpp"
        #include "alphaTokenCodes.hpp"
%}


/* Flex set options. */
%option yylineno 
%option noyywrap
%option outfile="alphaFLexer.cpp"

/* FLex regex definitions */

id              [a-zA-Z][a-zA-Z_0-9]*
integer         (0[xX][0-9a-fA-F]+)|([0-9]+)
real            ([0-9]*\.[0-9]+([eE][\+-]?[0-9]+)?)
newline         "\n"
space           [ \r\t\v]

%%

"if"            {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(IF); } 
"else"          {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(ELSE);} 
"while"         {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(WHILE);} 
"for"           {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(FOR);} 
"function"      {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(FUNCTION);} 
"return"        {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(RETURN);} 
"break"         {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(BREAK);} 
"continue"      {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(CONTINUE);} 
"and"           {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(AND);} 
"not"           {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(NOT);} 
"or"            {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(OR);} 
"local"         {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(LOCAL);} 
"true"          {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(TRUE);} 
"false"         {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(FALSE);} 
"nil"           {ALPHA_EXPORT_KEYWORD_TOKEN(); ALPHA_RETURN_KEYWORD_CODE(NIL);} 


"="             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(ASSIGN);} 
"+"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(PLUS);} 
"-"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(MINUS);} 
"*"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(MUL);} 
"/"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(DIV);} 
"%"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(MOD);} 
"=="            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(EQUAL);} 
"!="            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(NOT_EQUAL);} 
"++"            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(PLUS_PLUS);} 
"--"            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(MINUS_MINUS);} 
">"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(GREATER_THAN);} 
"<"             {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(LESS_THAN);} 
">="            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(GREATER_THAN_OR_EQUAL);} 
"<="            {ALPHA_EXPORT_OPERATOR_TOKEN(); ALPHA_RETURN_OPERATOR_CODE(LESS_THAN_OR_EQUAL);} 

"{"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(LEFT_BRACE);}
"}"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(RIGHT_BRACE);}
"["             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(LEFT_BRACKET);}
"]"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(RIGHT_BRACKET);}
"("             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(LEFT_PARENTHESIS);}
")"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(RIGHT_PARENTHESIS);}
";"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(SEMI_COLON);}
","             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(COMMA);}
":"             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(COLON);}
"::"            {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(COLON_BLOCK);}
"."             {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(DOT);}
".."            {ALPHA_EXPORT_PUNCTUATION_TOKEN(); ALPHA_RETURN_PUNCTUATION_CODE(DDOT);}

{id}            {Alpha::Token::exportToken(yylval, yylineno, yytext, "ID"); return Alpha::idCode;}
{real}          {Alpha::Token::exportToken(yylval, yylineno, yytext, "CONST_FLOAT"); return static_cast<int>(Alpha::NumericTypeCodes::FLOAT_CONSTANT);}
{integer}       {Alpha::Token::exportToken(yylval, yylineno, yytext, "CONST_INT"); return static_cast<int>(Alpha::NumericTypeCodes::INTEGER_CONSTANT);}

{newline}*       /* Just eat up the new line. */
{space}*         /* Eating up spaces. */
<<EOF>>          {return 0;}
%%


