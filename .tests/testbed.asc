(15).method();   // This should be interpreted as int: '15' and member access operator.
(15)..method();  // This should be interpreted as int: '15' and method access operator..

v.method();      // VALID
(v).method();    // Invalid: LVALUE CASTED TO RVALUE

v..method();
(v)..method();   // Invalid: LVALUE CASTED TO RVALUE

15..method();    // This should be interpreted as float: '15.' and member access operator.
(15.).method();  // This should be interpreted as float: '15.' and member access operator.
15...method();   // This should be interpreted as float: '15.' and method access operator..
(15.)..method(); // This should be interpreted as float: '15.' and method access operator..
(2+3)..method(); // Trying to access method() using method operator.. on an INT constant
2+3..method();   // Trying to access method() using method operator.. on an INT constant
2+3...method();  // Trying to access method() using method operator.. on an INT constant
